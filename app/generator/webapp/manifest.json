{
  "_version": "1.65.0",
  "sap.app": {
    "id": "gisamdg.generator",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/generator/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "tracking-display": {
          "semanticObject": "tracking",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "gisamdg.generator.i18n.i18n",
          "async": true
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "GeneratorDataList",
          "target": "GeneratorDataList"
        },
        {
          "pattern": "GeneratorData({key}):?query:",
          "name": "GeneratorDataObjectPage",
          "target": "GeneratorDataObjectPage"
        }
      ],
      "targets": {
        "GeneratorDataList": {
          "type": "Component",
          "id": "GeneratorDataList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "GeneratorData",
              "variantManagement": "None",
              "navigation": {
                "GeneratorData": {
                  "detail": {
                    "route": "GeneratorDataObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "generate": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onGenerate",
                      "text": "Generieren",
                      "enabled": true
                    },
                    "push": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onPush",
                      "text": "An Backend pushen",
                      "enabled": true
                    },
                    "copy": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onCopy",
                      "text": "Daten kopieren",
                      "enabled": true
                    },
                    "deleteInSystem": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onDelete",
                      "text": "Im System löschen",
                      "enabled": true
                    },
                    "showTracking": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onShowTracking",
                      "text": "Tracking anzeigen",
                      "enabled": true
                    },
                    "showSystems": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onShowSystems",
                      "text": "Systeme verwalten",
                      "enabled": true
                    }
                  }
                }
              }
            }
          }
        },
        "GeneratorDataObjectPage": {
          "type": "Component",
          "id": "GeneratorDataObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "GeneratorData"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "gisamdg"
  }
}
