{
  "_version": "1.65.0",
  "sap.app": {
    "id": "gisamdg.generator",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "service/generator/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "generator-display": {
          "semanticObject": "generator",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "gisamdg.generator.i18n.i18n",
          "async": true
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MyRunsList",
          "target": "MyRunsList"
        },
        {
          "pattern": "MyRuns({key}):?query:",
          "name": "MyRunsObjectPage",
          "target": "MyRunsObjectPage"
        }
      ],
      "targets": {
        "MyRunsList": {
          "type": "Component",
          "id": "MyRunsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "MyRuns",
              "variantManagement": "None",
              "hideFilterBar": true,
              "navigation": {
                "MyRuns": {
                  "detail": {
                    "route": "MyRunsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "generate": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onGenerate",
                      "text": "Generieren & anlegen",
                      "enabled": true
                    },
                    "showTracking": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onShowTracking",
                      "text": "Tracking anzeigen",
                      "enabled": true
                    },
                    "showSystems": {
                      "press": "gisamdg.generator.ext.GeneratorActions.onShowSystems",
                      "text": "Systeme verwalten",
                      "enabled": true
                    }
                  }
                }
              },
              "initialLoad": true
            }
          }
        },
        "MyRunsObjectPage": {
          "type": "Component",
          "id": "MyRunsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "MyRuns"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#gisamdg.generator::MyRunsList": {
            "controllerName": "gisamdg.generator.ext.MyRunsNavigation"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "gisamasterdatagenerator.service"
  }
}
