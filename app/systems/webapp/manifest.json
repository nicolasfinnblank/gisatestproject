{
  "_version": "1.65.0",
  "sap.app": {
    "id": "gisamdg.systems",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "service/generator/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "systems-display": {
          "semanticObject": "systems",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "gisamdg.systems.i18n.i18n",
          "async": true
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SystemsList",
          "target": "SystemsList"
        },
        {
          "pattern": "Systems({key}):?query:",
          "name": "SystemsObjectPage",
          "target": "SystemsObjectPage"
        }
      ],
      "targets": {
        "SystemsList": {
          "type": "Component",
          "id": "SystemsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Systems",
              "variantManagement": "None",
              "initialLoad": true,
              "navigation": {
                "Systems": {
                  "detail": {
                    "route": "SystemsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "createSystem": {
                      "press": "gisamdg.systems.ext.SystemsActions.onCreateSystem",
                      "text": "Neues System",
                      "enabled": true
                    },
                    "backToGenerator": {
                      "press": "gisamdg.systems.ext.SystemsActions.onBackToGenerator",
                      "text": "Zum Generator",
                      "enabled": true
                    }
                  }
                }
              }
            }
          }
        },
        "SystemsObjectPage": {
          "type": "Component",
          "id": "SystemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Systems"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "gisamasterdatagenerator.service"
  }
}
