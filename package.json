{
  "name": "gisa-master-data-generator",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap-cloud-sdk/util": "^4.6.0",
    "@sap/cds": "^9",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4.13.0",
    "hdb": "^2.27.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^2",
    "jest": "^30.4.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest"
  },
  "jest": {
    "testTimeout": 120000
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sql",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "BackendAPI_2": {
        "kind": "odata",
        "model": "srv/external/BackendAPI_2"
      },
      "BackendAPI_3": {
        "kind": "odata",
        "model": "srv/external/BackendAPI_3"
      }
    }
  }
}
