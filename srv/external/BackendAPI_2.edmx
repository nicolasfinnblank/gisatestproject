        <Property Name="surName" Type="Edm.String"/>
        <NavigationProperty Name="address" Type="MasterDataGenerator.Address">
          <ReferentialConstraint Property="address_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="address_ID" Type="Edm.Guid"/>
      </EntityType>
      <EntityType Name="Address">
