        </NavigationProperty>
        <Property Name="street_ID" Type="Edm.Guid"/>
        <Property Name="houseNumber" Type="Edm.String" MaxLength="10" Nullable="false"/>
        <Property Name="postalCode" Type="Edm.String" MaxLength="5" Nullable="false"/>
        <NavigationProperty Name="city" Type="MasterDataGenerator.City">
          <ReferentialConstraint Property="city_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="city_ID" Type="Edm.Guid"/>
      </EntityType>
