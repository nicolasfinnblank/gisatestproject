  "BackendAPI_3.BusinessPartner": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "ID": {
     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Core.ComputedDefaultValue": true
    },
    "createdAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "@Common.Label": "Angelegt am"
    },
    "createdBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "doc": "Die eindeutige ID eines Benutzers",
     "@Common.Label": "Angelegt von"
    },
    "modifiedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "@Common.Label": "Geändert am"
    },
    "modifiedBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "doc": "Die eindeutige ID eines Benutzers",
     "@Common.Label": "Geändert von"
    },
    "businessPartnerNumber": {
     "type": "cds.Integer64",
     "notNull": true,
     "@Core.Computed": true,
     "@Validation.Minimum": 1,
     "@Validation.Maximum": 9999999999
    },
    "firstName": {
     "type": "cds.String",
     "@Common.FieldControl": {
      "#": "Mandatory"
     }
    },
    "surName": {
     "type": "cds.String",
     "@Common.FieldControl": {
      "#": "Mandatory"
     }
    },
    "address_ID": {
     "type": "cds.UUID"
    },
    "address": {
     "type": "cds.Association",
     "target": "BackendAPI_3.Address",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "address",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "address_ID"
       ]
      }
     ]
    }
   }
  },
