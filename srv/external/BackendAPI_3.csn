      "#": "Mandatory"
     }
    },
    "postalCode": {
     "type": "cds.String",
     "length": 5,
     "notNull": true,
     "@Validation.Pattern": "[0-9]{5}",
     "@Common.FieldControl": {
      "#": "Mandatory"
     }
    },
    "city_ID": {
     "type": "cds.UUID",
     "@Common.FieldControl": {
      "#": "Mandatory"
     }
    },
    "street": {
     "type": "cds.Association",
     "target": "BackendAPI_3.Street",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "street",
        "ID"
       ]
      },
