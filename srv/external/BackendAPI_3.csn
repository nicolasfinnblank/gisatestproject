     "type": "cds.UUID",
     "@Common.FieldControl": {
      "#": "Mandatory"
     }
    },
    "houseNumber": {
     "type": "cds.String",
     "length": 10,
     "notNull": true,
     "@Validation.Pattern": "[0-9]{1,4}[a-z]",
